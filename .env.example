# NEVU HQ — browser-safe variables
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only; NEVER expose these in NEXT_PUBLIC_ variables.
SUPABASE_SERVICE_ROLE_KEY=

# Local bridge only. Keep this secret and set the same value in the NEVU bridge.
NEVU_BRIDGE_SECRET=
NEVU_APP_URL=http://localhost:3000

# Optional: public URL used by the bridge callback/status page.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional direct AI provider adapters (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
XAI_API_KEY=
XAI_MODEL=
HF_TOKEN=
HF_MODEL=
